# YAML hygiene: only CI/pre-commit YAMLs are allowed in-tree.
# Block everything else by default and re-allow the known-good paths.
*.yml
*.yaml
!.github/workflows/ci.yml
!.pre-commit-config.yaml

# local dev (this clone; not published)
# Makefile: make docs / test / sync / fmt
# docs/: Fumadocs site
# scripts/: docs helpers (make docs-cli, screenshots)
/Makefile
docs/
scripts/
/CLAUDE.md
.vscode/
clean.sh
.github/workflows/docs.yml
.github/workflows/screenshots.yml
