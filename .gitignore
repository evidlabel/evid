# YAML hygiene: only CI/pre-commit YAMLs are allowed in-tree.
# Block everything else by default and re-allow the known-good paths.
*.yml
*.yaml
!.github/workflows/ci.yml
!.pre-commit-config.yaml

# local dev (this clone; not published)
# Makefile: make test / sync / fmt
# gui_readme_shots.py is tracked — README PNGs live in git
/Makefile
docs/
scripts/*
!scripts/gui_readme_shots.py
/AGENTS.md
.vscode/
clean.sh
.github/workflows/screenshots.yml
